# Yemen Net Bot Environment Variables
# متغيرات البيئة لبوت شبكات اليمن

# =============================================================================
# BOT CONFIGURATION - إعدادات البوت
# =============================================================================

# Telegram Bot Token (Required)
# رمز البوت من تيليجرام (مطلوب)
BOT_TOKEN=your_bot_token_here

# Webhook Configuration (Optional)
# إعدادات Webhook (اختياري)
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_PORT=8443
WEBHOOK_LISTEN=0.0.0.0

# =============================================================================
# DATABASE CONFIGURATION - إعدادات قاعدة البيانات
# =============================================================================

# Database Path (Optional, defaults to ./yemen_net.db)
# مسار قاعدة البيانات (اختياري، افتراضي ./yemen_net.db)
DB_PATH=./yemen_net.db

# Database Performance Settings (Optional)
# إعدادات أداء قاعدة البيانات (اختياري)
DB_TIMEOUT=30.0
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_CACHE_SIZE=1000
DB_TEMP_STORE=memory

# =============================================================================
# BUSINESS CONFIGURATION - إعدادات الأعمال
# =============================================================================

# Commission Rates (Optional, defaults shown)
# معدلات العمولات (اختياري، القيم الافتراضية موضحة)
CARD_COMMISSION_RATE=0.10
AGENT_COMMISSION_RATE=0.05

# Transfer Limits (Optional, defaults shown)
# حدود التحويل (اختياري، القيم الافتراضية موضحة)
MAX_TRANSFER_AMOUNT=10000.0
MIN_TRANSFER_AMOUNT=1.0

# =============================================================================
# LOGGING CONFIGURATION - إعدادات التسجيل
# =============================================================================

# Log Level (Optional, defaults to INFO)
# مستوى التسجيل (اختياري، افتراضي INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log File Path (Optional, defaults to bot.log)
# مسار ملف السجل (اختياري، افتراضي bot.log)
LOG_FILE=bot.log

# =============================================================================
# SECURITY CONFIGURATION - إعدادات الأمان
# =============================================================================

# Encryption Key (Optional, auto-generated if not provided)
# مفتاح التشفير (اختياري، يتم إنشاؤه تلقائياً إذا لم يتم توفيره)
ENCRYPTION_KEY=your_encryption_key_here

# Rate Limiting (Optional, defaults shown)
# تحديد معدل الطلبات (اختياري، القيم الافتراضية موضحة)
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60

# =============================================================================
# PERFORMANCE CONFIGURATION - إعدادات الأداء
# =============================================================================

# Connection Pool Size (Optional, defaults shown)
# حجم مجموعة الاتصالات (اختياري، القيم الافتراضية موضحة)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache Settings (Optional, defaults shown)
# إعدادات التخزين المؤقت (اختياري، القيم الافتراضية موضحة)
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# NOTIFICATION CONFIGURATION - إعدادات الإشعارات
# =============================================================================

# Admin Notifications (Optional)
# إشعارات المشرفين (اختياري)
ADMIN_CHAT_ID=your_admin_chat_id_here
ADMIN_NOTIFICATIONS=true

# Error Reporting (Optional)
# تقارير الأخطاء (اختياري)
ERROR_REPORTING=true
ERROR_WEBHOOK_URL=https://your-error-reporting-service.com

# =============================================================================
# DEVELOPMENT CONFIGURATION - إعدادات التطوير
# =============================================================================

# Debug Mode (Optional, defaults to false)
# وضع التصحيح (اختياري، افتراضي false)
DEBUG=false

# Test Mode (Optional, defaults to false)
# وضع الاختبار (اختياري، افتراضي false)
TEST_MODE=false

# =============================================================================
# EXTERNAL SERVICES - الخدمات الخارجية
# =============================================================================

# Payment Gateway (Optional)
# بوابة الدفع (اختياري)
PAYMENT_GATEWAY_URL=https://your-payment-gateway.com
PAYMENT_API_KEY=your_payment_api_key_here

# SMS Service (Optional)
# خدمة الرسائل النصية (اختياري)
SMS_SERVICE_URL=https://your-sms-service.com
SMS_API_KEY=your_sms_api_key_here

# =============================================================================
# MONITORING CONFIGURATION - إعدادات المراقبة
# =============================================================================

# Health Check URL (Optional)
# رابط فحص صحة النظام (اختياري)
HEALTH_CHECK_URL=https://your-domain.com/health

# Metrics Collection (Optional)
# جمع المقاييس (اختياري)
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# BACKUP CONFIGURATION - إعدادات النسخ الاحتياطي
# =============================================================================

# Auto Backup (Optional)
# النسخ الاحتياطي التلقائي (اختياري)
AUTO_BACKUP=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION=7

# Backup Storage (Optional)
# تخزين النسخ الاحتياطية (اختياري)
BACKUP_STORAGE_PATH=./backups
BACKUP_STORAGE_TYPE=local

# =============================================================================
# NOTES - ملاحظات
# =============================================================================

# 1. Copy this file to .env and fill in your actual values
#    انسخ هذا الملف إلى .env واملأ القيم الفعلية

# 2. Never commit .env file to version control
#    لا تقم أبداً برفع ملف .env إلى نظام التحكم بالإصدارات

# 3. Keep your BOT_TOKEN secure and private
#    احتفظ برمز البوت آمناً وسرياً

# 4. Test all configurations in development environment first
#    اختبر جميع الإعدادات في بيئة التطوير أولاً

# 5. Monitor logs for any configuration errors
#    راقب السجلات لأي أخطاء في الإعدادات