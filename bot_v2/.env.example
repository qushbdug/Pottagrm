# Yemen Net Bot v2 - Environment Variables Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# BOT CONFIGURATION
# =============================================================================

# Your Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Bot display name and username
BOT_NAME=Yemen Net Bot
BOT_USERNAME=yemen_net_bot

# Admin user ID (optional)
ADMIN_USER_ID=123456789

# Environment (development/production)
ENVIRONMENT=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database file path
DB_PATH=yemen_net.db

# Database connection timeout (seconds)
DB_TIMEOUT=30

# Maximum database connections
DB_MAX_CONNECTIONS=10

# =============================================================================
# RATE LIMITING
# =============================================================================

# Maximum requests per user per minute
RATE_LIMIT_REQUESTS=30

# Rate limiting time window (seconds)
RATE_LIMIT_WINDOW=60

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Cache TTL (seconds)
CACHE_TTL=300

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=100

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Session timeout (seconds)
SESSION_TIMEOUT=3600

# Maximum login attempts
MAX_LOGIN_ATTEMPTS=5

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================

# Enable notifications
ENABLE_NOTIFICATIONS=true

# Notification interval (seconds)
NOTIFICATION_INTERVAL=300

# =============================================================================
# MONITORING SETTINGS
# =============================================================================

# Enable system monitoring
ENABLE_MONITORING=true

# Monitoring interval (seconds)
MONITORING_INTERVAL=60

# =============================================================================
# BACKUP SETTINGS
# =============================================================================

# Enable automatic backups
ENABLE_AUTO_BACKUP=true

# Backup interval (seconds) - 24 hours default
BACKUP_INTERVAL=86400

# =============================================================================
# LOGGING SETTINGS
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/bot.log

# Maximum log file size (MB)
LOG_MAX_SIZE=10

# Number of log backup files
LOG_BACKUP_COUNT=5

# =============================================================================
# WEBHOOK SETTINGS (Optional - for production)
# =============================================================================

# Webhook URL (leave empty for polling)
WEBHOOK_URL=

# Webhook port
WEBHOOK_PORT=8443

# Webhook certificate path
WEBHOOK_CERT=

# Webhook private key path
WEBHOOK_KEY=

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# SMTP Server for email notifications
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Redis connection (for advanced caching)
REDIS_URL=

# MongoDB connection (for advanced data storage)
MONGODB_URL=

# =============================================================================
# PAYMENT SETTINGS
# =============================================================================

# Minimum transfer amount
MIN_TRANSFER_AMOUNT=1.0

# Maximum transfer amount
MAX_TRANSFER_AMOUNT=10000.0

# Transfer fee percentage
TRANSFER_FEE_PERCENT=0.5

# Minimum balance for transfer
MIN_BALANCE_FOR_TRANSFER=10.0

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable analytics
ENABLE_ANALYTICS=true

# Enable user referrals
ENABLE_REFERRALS=true

# Enable card trading
ENABLE_CARD_TRADING=true

# Enable cryptocurrency support
ENABLE_CRYPTO=false

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Debug mode
DEBUG=false

# Test mode
TEST_MODE=false

# Mock external services
MOCK_EXTERNAL_SERVICES=false

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit your actual .env file to version control
# 2. Keep your BOT_TOKEN secure and private
# 3. Adjust values based on your server capabilities
# 4. Monitor system resources when adjusting limits
# 5. Test thoroughly in development before production